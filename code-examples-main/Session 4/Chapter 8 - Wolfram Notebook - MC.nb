Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Kappa]1LN", "[", 
    RowBox[{"n_", ",", "\[Sigma]_"}], "]"}], ":=", 
   RowBox[{"2", "-", 
    FractionBox[
     RowBox[{"Log", "[", "n", "]"}], 
     RowBox[{"Log", "[", 
      RowBox[{"n", 
       FractionBox[
        RowBox[{"Erf", "[", 
         FractionBox[
          SqrtBox[
           RowBox[{"Log", "[", 
            FractionBox[
             RowBox[{"n", "+", 
              SuperscriptBox["\[ExponentialE]", 
               SuperscriptBox["\[Sigma]", "2"]], "-", "1"}], "n"], "]"}]], 
          RowBox[{"2", 
           SqrtBox["2"]}]], "]"}], 
        RowBox[{"Erf", "[", 
         FractionBox["\[Sigma]", 
          RowBox[{"2", 
           SqrtBox["2"]}]], "]"}]]}], "]"}]]}]}], ";"}]], "Input",
